@model BorrowingConfiguration
@{
    ViewData["Title"] = "Edit Borrowing Configuration";
}

<div class="page-header">
    <h1>Edit Borrowing Configuration</h1>
</div>

<div class="form-container">
    <form asp-action="EditConfiguration" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ConfigId" />
        <input type="hidden" asp-for="LibraryId" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="LoanDurationDays"></label>
            <input asp-for="LoanDurationDays" class="form-control" type="number" />
            <span asp-validation-for="LoanDurationDays" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="MaxRenewals"></label>
            <input asp-for="MaxRenewals" class="form-control" type="number" />
            <span asp-validation-for="MaxRenewals" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="MaxBorrowableItems"></label>
            <input asp-for="MaxBorrowableItems" class="form-control" type="number" />
            <span asp-validation-for="MaxBorrowableItems" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="OverduePenaltyPerDay"></label>
            <input asp-for="OverduePenaltyPerDay" class="form-control" type="number" step="0.01" />
            <span asp-validation-for="OverduePenaltyPerDay" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-action="Profile" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
