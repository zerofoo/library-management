@model List<Book>
@{
    ViewData["Title"] = "Browse Books";
}

<div class="page-header">
    <h1>Browse Books</h1>
</div>

<div class="filter-section">
    <form method="get" class="filter-form">
        <div class="filter-group">
            <input type="text" name="search" placeholder="Search by title, author, or genre" value="@ViewBag.Search" class="form-control" />
            <select name="genre" class="form-control">
                <option value="">All Genres</option>
                @if (ViewBag.Genres != null)
                {
                    foreach (var genre in (List<string>)ViewBag.Genres)
                    {
                        <option value="@genre" selected="@(ViewBag.Genre == genre)">@genre</option>
                    }
                }
            </select>
            <button type="submit" class="btn btn-secondary">Filter</button>
            <a asp-action="Browse" class="btn btn-secondary">Clear</a>
        </div>
    </form>
</div>

<div class="books-grid">
    @foreach (var book in Model)
    {
        <div class="book-card">
            <div class="book-cover">
                @if (!string.IsNullOrEmpty(book.CoverImagePath))
                {
                    <img src="@book.CoverImagePath" alt="@book.Title" />
                }
                else
                {
                    <div class="book-cover-placeholder">📖</div>
                }
            </div>
            <div class="book-info">
                <h3 class="book-title">@book.Title</h3>
                <p class="book-author">by @book.Author</p>
                <p class="book-genre">@book.Genre</p>
                <div class="rating-display">
                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= book.AverageRating)
                        {
                            <span class="star filled">★</span>
                        }
                        else
                        {
                            <span class="star">☆</span>
                        }
                    }
                    <span class="rating-text">(@book.BookRatings.Count)</span>
                </div>
                <div class="book-availability">
                    @if (book.AvailableCopies > 0)
                    {
                        <span class="badge badge-available">@book.AvailableCopies available</span>
                    }
                    else
                    {
                        <span class="badge badge-unavailable">Out of Stock</span>
                    }
                </div>
                <a asp-action="BookDetails" asp-route-id="@book.BookId" class="btn btn-primary btn-block">View Details</a>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <p>No books found matching your search criteria.</p>
    </div>
}
